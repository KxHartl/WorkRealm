# Each language's own standard formatting (R-NAMES, level 3). Editors read this; nothing enforces it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi,java,kt,cs,rs,c,h,cc,cpp,hpp,php,sql,ps1,psm1}]
indent_size = 4

[{*.go,Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf
