#!/bin/sh
# Installed by WorkRealm (core.hooksPath = .githooks). The checks live in .ai/policy.py.
# A hook the repository already had in .git/hooks still runs: core.hooksPath would silence it.
LOCAL="$(git rev-parse --git-common-dir)/hooks/commit-msg"
if [ -x "$LOCAL" ]; then "$LOCAL" "$@" || exit $?; fi
PY=$(command -v python || command -v python3) || { echo "commit-msg: python not found; checks skipped" >&2; exit 0; }
exec "$PY" "$(git rev-parse --show-toplevel)/.ai/policy.py" commit-msg "$1"
